{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Wrangler Worker Debuggen",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["wrangler", "dev"],
      "attachSimplePort": 8789,
      "outFiles": ["${workspaceFolder}/.wrangler/**/*.js"]
    }
  ]
}
